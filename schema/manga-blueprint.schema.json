{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c-a-p-engineer.github.io/manga-blueprint-studio/schema/manga-blueprint.schema.json",
  "title": "Manga Blueprint",
  "description": "Provider-independent semantic blueprint for manga layout, reusable character identity, stable work/page/container identity, optional text-based appearance guidance, global art direction, story action intent, pose/support/depth semantics, scene continuity, background, balloon/SFX writing direction, text, manga effects, bounded-assistance provenance, and optional convex-quadrilateral panel geometry.",
  "type": "object",
  "required": ["format", "meta", "pages"],
  "properties": {
    "format": { "type": "string", "const": "manga-blueprint/0.2" },
    "meta": {
      "type": "object",
      "required": ["title", "readingDirection", "pageWidth", "pageHeight"],
      "properties": {
        "workId": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "readingDirection": { "enum": ["rtl", "ltr"] },
        "defaultWritingMode": { "enum": ["vertical-rl", "horizontal-tb"] },
        "pageWidth": { "type": "number", "minimum": 320, "maximum": 4000 },
        "pageHeight": { "type": "number", "minimum": 320, "maximum": 6000 },
        "canvasPreset": { "type": "string" },
        "layoutPreset": { "type": "string" },
        "storyTemplate": { "type": "string" },
        "randomPurpose": { "type": "string" },
        "randomSeed": { "type": "string" },
        "randomVariant": { "enum": ["balanced", "dynamic", "emotion"] },
        "randomIntensity": { "enum": ["stable", "standard", "bold"] },
        "artDirection": { "$ref": "#/$defs/artDirection" }
      },
      "additionalProperties": true
    },
    "containers": { "type": "array", "items": { "$ref": "#/$defs/container" } },
    "characterLibrary": { "type": "array", "items": { "$ref": "#/$defs/baseCharacter" } },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
  },
  "additionalProperties": true,
  "$defs": {
    "rect": { "type": "object", "required": ["x","y","w","h"], "properties": { "x":{"type":"number"},"y":{"type":"number"},"w":{"type":"number","exclusiveMinimum":0},"h":{"type":"number","exclusiveMinimum":0} }, "additionalProperties": false },
    "point": { "type":"object", "required":["x","y"], "properties": { "x":{"type":"number"},"y":{"type":"number"} }, "additionalProperties": false },
    "panelShape": { "type":"object", "required":["kind","points"], "properties": { "kind":{"const":"quad"},"preset":{"enum":["rectangle","diagonal-left","diagonal-right","trapezoid-left","trapezoid-right","custom"]},"points":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/point"}} }, "additionalProperties": true },
    "panelInset": { "type":"object", "required":["kind","parentPanelId"], "properties": { "kind":{"const":"panel-in-panel"},"parentPanelId":{"type":"string","minLength":1},"anchor":{"enum":["top-right","top-left","bottom-right","bottom-left","center"]},"size":{"enum":["small","medium","large"]} }, "additionalProperties": true },
    "container": {
      "type": "object",
      "required": ["id","kind","title","order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["volume","chapter","folder"] },
        "title": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "parentId": { "type": ["string","null"] }
      },
      "additionalProperties": true
    },
    "artDirection": {
      "type": "object",
      "properties": {
        "preset": { "type": "string" },
        "colorMode": { "enum": ["auto","color","monochrome","grayscale","limited"] },
        "renderStyle": { "enum": ["auto","anime","manga","pencil","ink","watercolor","webtoon","cel","realistic","sketch","retro-manga","chibi"] },
        "lineStyle": { "enum": ["clean","bold","fine","rough","brush","pencil"] },
        "shading": { "enum": ["flat","cel","soft","screentone","crosshatch","pencil","painted"] },
        "detailLevel": { "enum": ["low","medium","high"] },
        "backgroundFinish": { "enum": ["match","detailed","simplified","graphic","minimal"] },
        "palette": { "type": "string" },
        "tone": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "camera": { "type": "object", "required": ["distance","angle","viewpoint","focus","intent"], "properties": { "distance":{"enum":["extreme-long","long","medium","close","extreme-close"]},"angle":{"enum":["eye-level","low-angle","high-angle","birds-eye","worms-eye","dutch-angle","over-shoulder"]},"viewpoint":{"enum":["front","three-quarter-front","side","three-quarter-back","back","pov","near-object"]},"focus":{"type":"string"},"intent":{"type":"string"},"depthTarget":{"enum":["auto","right-hand","left-hand","right-foot","left-foot","face","prop","none"]},"foreshortening":{"enum":["normal","strong","extreme"]} }, "additionalProperties": true },
    "panelStyle": { "type":"object", "required":["border","bleed","breakout"], "properties": { "border":{"enum":["normal","borderless","inset","impact"]},"bleed":{"enum":["none","top","right","bottom","left","all"]},"breakout":{"enum":["none","character","foreground","cross-panel"]} }, "additionalProperties": true },
    "background": { "type":"object", "required":["location","timeOfDay","weather","mood","detailLevel","renderMode","notes"], "properties": { "location":{"type":"string"},"timeOfDay":{"type":"string"},"weather":{"type":"string"},"mood":{"type":"string"},"detailLevel":{"enum":["none","low","medium","high"]},"renderMode":{"enum":["normal","selective-detail","white","blur","speed-lines","focus-lines","black"]},"notes":{"type":"string"},"sceneId":{"type":"string"},"continuityFrom":{"type":"string"},"anchorNotes":{"type":"string"} }, "additionalProperties": true },
    "effects": { "type":"object", "required":["lineEffect","strength","sfxText","sfxStyle","notes"], "properties": { "lineEffect":{"enum":["none","speed","focus","impact","tension","silence"]},"strength":{"enum":["low","medium","high"]},"sfxText":{"type":"string"},"sfxStyle":{"type":"string"},"sfxWritingMode":{"enum":["inherit","vertical-rl","horizontal-tb"]},"notes":{"type":"string"} }, "additionalProperties": true },
    "expression": { "type":"object", "required":["type","intensity","notes"], "properties": { "type":{"type":"string"},"intensity":{"type":"number","minimum":0,"maximum":1},"notes":{"type":"string"} }, "additionalProperties": true },
    "gaze": { "type":"object", "required":["target","notes"], "properties": { "target":{"type":"string"},"notes":{"type":"string"} }, "additionalProperties": true },
    "appearance": { "type":"object", "properties": { "summary":{"type":"string"},"hair":{"type":"string"},"eyes":{"type":"string"},"outfit":{"type":"string"},"features":{"type":"string"} }, "additionalProperties": true },
    "baseCharacter": { "type":"object", "required":["characterId","name","referenceKey","poseId"], "properties": { "characterId":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"referenceKey":{"type":"string"},"poseId":{"type":"string","minLength":1},"notes":{"type":"string"},"identityMode":{"enum":["sheet","description","free"]},"appearance":{"$ref":"#/$defs/appearance"} }, "additionalProperties": true },
    "characterInstance": { "type":"object", "required":["id","characterId","name","referenceKey","x","y","scale","rotation","poseId","expression","gaze"], "properties": { "id":{"type":"string","minLength":1},"characterId":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"referenceKey":{"type":"string"},"x":{"type":"number"},"y":{"type":"number"},"scale":{"type":"number","exclusiveMinimum":0},"rotation":{"type":"number"},"poseId":{"type":"string","minLength":1},"supportState":{"enum":["auto","grounded","airborne","supported","unknown"]},"motionPhase":{"enum":["auto","still","anticipation","approach","launch","airborne","impact","recovery"]},"expression":{"$ref":"#/$defs/expression"},"gaze":{"$ref":"#/$defs/gaze"} }, "additionalProperties": true },
    "balloon": { "type":"object", "required":["id","type","speakerId","text","x","y","size"], "properties": { "id":{"type":"string","minLength":1},"type":{"enum":["speech","thought","shout","whisper","narration","offscreen"]},"speakerId":{"type":"string"},"text":{"type":"string"},"writingMode":{"enum":["inherit","vertical-rl","horizontal-tb"]},"x":{"type":"number"},"y":{"type":"number"},"size":{"type":"number","exclusiveMinimum":0} }, "additionalProperties": true },
    "panel": { "type":"object", "required":["id","order","rect","role","style","camera","background","effects","characters","balloons"], "properties": { "id":{"type":"string","minLength":1},"order":{"type":"integer","minimum":1},"rect":{"$ref":"#/$defs/rect"},"shape":{"$ref":"#/$defs/panelShape"},"inset":{"$ref":"#/$defs/panelInset"},"role":{"type":"string"},"actionIntent":{"type":"string"},"style":{"$ref":"#/$defs/panelStyle"},"camera":{"$ref":"#/$defs/camera"},"background":{"$ref":"#/$defs/background"},"effects":{"$ref":"#/$defs/effects"},"characters":{"type":"array","items":{"$ref":"#/$defs/characterInstance"}},"balloons":{"type":"array","items":{"$ref":"#/$defs/balloon"}},"assistSeed":{"type":"string"} }, "additionalProperties": true },
    "page": {
      "type":"object",
      "required":["id","panels"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "title":{"type":"string"},
        "pageNumber":{"type":"integer","minimum":1},
        "order":{"type":"integer","minimum":1},
        "containerId":{"type":["string","null"]},
        "panels":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/panel"}}
      },
      "additionalProperties": true
    }
  }
}
